# StudySync AI — Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studysync?schema=public"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Dedicated Admin JWT Secret (Isolated from student sessions)
ADMIN_JWT_SECRET=your-secure-admin-secret-change-me
ADMIN_JWT_EXPIRES_IN=12h

# BYOK API Key AES-256-GCM Encryption Master Key (Required in production)
BYOK_ENCRYPTION_SECRET=your-32-byte-byok-encryption-secret-change-me

# Email Configuration (SMTP / Gmail / SendGrid)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="StudySync AI <reminders@studysync.ai>"
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=reminders@studysync.ai

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Groq API (Single key or comma-separated rotation pool)
GROQ_API_KEY=
GROQ_API_KEYS=

# Google Gemini API (Single key or comma-separated rotation pool)
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Tavily AI Search API
TAVILY_API_KEY=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
